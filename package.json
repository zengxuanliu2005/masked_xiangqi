{
  "name": "masked-xiangqi",
  "version": "1.1.0",
  "private": true,
  "description": "本机与局域网双人象棋盲棋游戏，以及可供 Agent 调用的 REST API",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "zengxuanliu2005",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengxuanliu2005/masked_xiangqi.git"
  },
  "bugs": {
    "url": "https://github.com/zengxuanliu2005/masked_xiangqi/issues"
  },
  "homepage": "https://github.com/zengxuanliu2005/masked_xiangqi#readme",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --production",
    "agent:run": "node --import tsx server/agent/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:chromium": "npm run build && playwright test --project=chromium",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "smoke:ollama": "tsx scripts/smoke-ollama.ts",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:start": "node scripts/smoke-production.mjs --skip-install",
    "release:audit": "node scripts/release-audit.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "release:check": "npm run check && npm run test:security && npm run test:stress && npm run test:e2e && npm run smoke:production && npm audit && npm run release:audit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
